{
  "name": "hajznow-booking",
  "version": "1.0.0",
  "description": "HajzNow — Venue & hall booking SaaS (Cloudflare Workers + D1)",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hajznow_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hajznow_db --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@cloudflare/workers-types": "^4.20240620.0",
    "wrangler": "^3.60.0"
  }
}
